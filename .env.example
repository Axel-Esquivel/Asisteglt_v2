# Copiar a .env (no se versiona) y ajustar. La API y el worker validan estas variables al arrancar.
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:4200

# Almacén: mongo (docker/docker-compose.yml) o memory (demo/pruebas, se pierde al reiniciar)
DATA_STORE=mongo

# Datos (docker/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/asisteglt?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Seguridad (generar uno propio: openssl rand -base64 48)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
SECURE_COOKIES=false
# Intentos de inicio de sesión por IP y minuto (registro: los mismos por 10 minutos; refresh: ×6)
AUTH_RATE_LIMIT_PER_MINUTE=10
# Proxies de confianza para la IP real del cliente: none | loopback | 1 | 2
TRUST_PROXY=none

# Archivos cargados por el cliente (confidenciales; fuera del repositorio) y umbral de rechazo
STORAGE_DIR=var/storage
IMPORT_REJECT_THRESHOLD_PERCENT=20

# Datos de demostración ficticios al arrancar (true solo para pruebas)
DEMO_SEED=false

# Worker
WORKER_CONCURRENCY=2
