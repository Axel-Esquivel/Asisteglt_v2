# Configuración de `npm run start:demo` (Nx la carga para `api:serve:demo`).
# Modo demostración: todo en memoria y datos FICTICIOS; no usar en producción.
NODE_ENV=development
DATA_STORE=memory
DEMO_SEED=true
MONGODB_URI=mongodb://localhost:27017/demo
REDIS_URL=redis://localhost:6379
JWT_SECRET=secreto-solo-para-la-demostracion-local-0123456789
