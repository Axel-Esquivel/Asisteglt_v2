# Configuración de la API para las pruebas e2e (`nx run api:serve:e2e`, la arranca Playwright).
# Con su propia configuración Nx no carga .env.development ni los .local de cada equipo, así que
# las pruebas corren siempre igual. Datos en memoria y valores de prueba; no usar en producción.
NODE_ENV=test
LOG_LEVEL=warn
API_PORT=3000
API_CORS_ORIGINS=http://localhost:4200
DATA_STORE=memory
MONGODB_URI=mongodb://localhost:27017/e2e
REDIS_URL=redis://localhost:6379
JWT_SECRET=secreto-e2e-con-al-menos-32-caracteres
SECURE_COOKIES=false
# Cada prueba registra usuarios nuevos desde la misma IP.
AUTH_RATE_LIMIT_PER_MINUTE=1000
TRUST_PROXY=none
STORAGE_DIR=var/storage-e2e
DEMO_SEED=false
METRICS_TOKEN=
