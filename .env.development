# Configuración de DESARROLLO con valores de PRUEBA. Se versiona a propósito: nada de esto es un
# secreto real. Con NODE_ENV=production la API rechaza JWT_SECRET, METRICS_TOKEN y DEMO_SEED=true de
# este archivo, y backup.js rechaza su BACKUP_PASSPHRASE. No expongas esta configuración en una red:
# para un servidor con datos reales usa los paquetes de docker/ (docs/13 §3.2, docs/18).
#
# Nx la carga sola en la configuración «development» (npm run start:api, start:web, start:dev,
# start:worker); no hace falta copiarla. Para cambiar algo solo en tu equipo crea
# .env.development.local (no se versiona) con las líneas a reemplazar: tiene prioridad sobre este
# archivo. Las variables del sistema tienen prioridad sobre ambos
# (PowerShell: $env:API_PORT='3001'; npm run start:api).
# Comprobar qué valores quedan en uso: npm run dev:check

NODE_ENV=development
LOG_LEVEL=debug
APP_VERSION=0.0.0-dev

# API (la web de desarrollo usa el proxy /api → http://localhost:3000, apps/web/proxy.conf.json)
API_PORT=3000
API_CORS_ORIGINS=http://localhost:4200

# Almacén: mongo con los servicios de docker/docker-compose.yml (npm run services:up).
# Sin Docker: DATA_STORE=memory en .env.development.local (los datos se pierden al reiniciar).
DATA_STORE=mongo
MONGODB_URI=mongodb://localhost:27017/asisteglt_dev?replicaSet=rs0&directConnection=true
# Requerida por la configuración; hoy la cola y la presencia del chat funcionan en proceso.
REDIS_URL=redis://localhost:6379

# Seguridad (valores de prueba; para producción generar con openssl rand -base64 48)
JWT_SECRET=solo-desarrollo-secreto-jwt-de-prueba-no-usar-en-produccion
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
SECURE_COOKIES=false
# Más holgado que en producción (10) para probar con varias pestañas y usuarios.
AUTH_RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=none

# Archivos cargados (var/ no se versiona) y umbral de rechazo de líneas
STORAGE_DIR=var/storage-dev
IMPORT_REJECT_THRESHOLD_PERCENT=20

# Datos FICTICIOS al arrancar la primera vez (usuarios *@demo.asisteglt.local, contraseña
# DemoAsiste2026, un proyecto de Reportes y otro de Inventarios). No se duplican al reiniciar.
DEMO_SEED=true

# Métricas (en Windows usa curl.exe):
#   curl -H "Authorization: Bearer solo-desarrollo-token-de-metricas" http://localhost:3000/api/v1/metrics
METRICS_TOKEN=solo-desarrollo-token-de-metricas

# Worker
WORKER_CONCURRENCY=2

# Respaldos: backup.js no pasa por Nx, se le indica el archivo con node --env-file=.env.development
# (ver docs/13-puesta-en-marcha.md §3). Con NODE_ENV=production esta frase se rechaza.
BACKUP_PASSPHRASE=solo-desarrollo-frase-de-respaldo
