{
  "name": "asisteglt",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start:web": "nx serve web",
    "start:api": "nx serve api",
    "start:demo": "nx run-many -t serve -p api web -c demo",
    "start:demo:lan": "nx run-many -t serve -p api web -c demo-lan",
    "start:worker": "nx serve worker",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint && npm run lint:styles && npm run lint:guard",
    "lint:styles": "stylelint \"{apps,libs}/**/*.scss\"",
    "lint:guard": "node tools/lint-guard/check.mjs",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "playwright test -c apps/web-e2e/playwright.config.mts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "services:up": "docker compose -f docker/docker-compose.yml up -d",
    "services:down": "docker compose -f docker/docker-compose.yml down"
  },
