{
  "name": "shared-kernel",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/kernel/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:domain"
  ],
  "// targets": "to see all targets run: nx show project shared-kernel --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "commands": [
          "tsc -p libs/shared/kernel/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/kernel/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
