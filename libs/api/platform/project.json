{
  "name": "api-platform",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/platform/src",
  "projectType": "library",
  "tags": [
    "scope:api",
    "type:platform"
  ],
  "// targets": "to see all targets run: nx show project api-platform --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "commands": [
          "tsc -p libs/api/platform/tsconfig.lib.json --noEmit",
          "tsc -p libs/api/platform/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
