# Web de AsisteGLT (PWA) servida por nginx con HTTPS y proxy hacia la API.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx nx build web --configuration=production --skip-nx-cache

FROM nginx:1.27-alpine
COPY docker/local-server/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/apps/web/browser /usr/share/nginx/html
EXPOSE 80 443
