# API de AsisteGLT (servidor local y producción). Incluye backup.js para respaldos.
# Debian (glibc): argon2 trae binarios precompilados para glibc, no para Alpine (musl).
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Compila en producción y genera package.json + lockfile podados para el despliegue.
RUN npx nx run api:prune --configuration=production --skip-nx-cache

FROM node:22-bookworm-slim
ARG APP_VERSION=0.1.0
ENV NODE_ENV=production APP_VERSION=${APP_VERSION}
WORKDIR /app
COPY --from=build /workspace/dist/apps/api ./
RUN npm ci --omit=dev --ignore-scripts && mkdir -p /data/storage && chown -R node:node /app /data
USER node
EXPOSE 3000
CMD ["node", "main.js"]
