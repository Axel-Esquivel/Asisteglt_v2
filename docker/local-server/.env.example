# Copiar a docker/local-server/.env (no se versiona) y completar.
# Dirección con la que los celulares abren la aplicación (la IP de la laptop servidor).
API_CORS_ORIGINS=https://192.168.1.20
# Generar uno propio: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
DEMO_SEED=false
IMPORT_REJECT_THRESHOLD_PERCENT=20
