# Copiar a docker/production/.env (no se versiona) y completar. Generar secretos con:
#   openssl rand -base64 48   (JWT_SECRET, BACKUP_PASSPHRASE)   ·   openssl rand -hex 24 (contraseñas, METRICS_TOKEN)
ASISTEGLT_VERSION=1.0.0
REGISTRY_OWNER=axel-esquivel
# Dirección pública con la que los usuarios abren la aplicación (origen permitido por CORS).
PUBLIC_URL=https://asisteglt.example.com
JWT_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Frase de los respaldos: guárdala fuera del servidor; sin ella no se puede restaurar.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
METRICS_TOKEN=
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MINUTE=10
IMPORT_REJECT_THRESHOLD_PERCENT=20
